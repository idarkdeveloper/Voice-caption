    <string name="onboarding_notifications_skip">Not now</string>
    <string name="onboarding_notifications_denied">Without notifications you won\'t see the Stop shortcut. Captions still work. You can allow them in settings.</string>
    <string name="onboarding_mic_title">Capture the sound your phone is playing</string>
    <string name="onboarding_mic_body">No microphone audio is recorded. Captions use only the audio your phone is playing. Android requires this permission to capture playback.</string>
